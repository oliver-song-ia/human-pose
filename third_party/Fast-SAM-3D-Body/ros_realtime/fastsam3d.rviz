Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 10
      Color: 130; 140; 150
      Alpha: 0.35
    - Class: rviz_default_plugins/MarkerArray
      Name: PoseMesh
      Enabled: true
      Topic:
        Value: /fastsam3d/mesh
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Namespaces:
        {}
    - Class: rviz_default_plugins/Image
      Name: Overlay
      Enabled: true
      Topic:
        Value: /fastsam3d/overlay/compressed
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Max Value: 1
      Min Value: 0
      Normalize Range: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
  Global Options:
    Background Color: 30; 34; 40
    Fixed Frame: fastsam3d_world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 4.5
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.9
      Pitch: 0.25
      Yaw: 3.14
      Target Frame: fastsam3d_world
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1500
  Displays:
    collapsed: false
